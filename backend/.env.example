# Database URL - required for connecting to PostgreSQL
DB_URL=postgresql://math2latex_user:math2latex_pass@db:5432/math2latex

# Redis URL - required for background job queue
REDIS_URL=redis://redis:6379/0

# Authentication secret - change before deploying to production
AUTH_SECRET=local-development-secret-change-before-deploy-2026

# Whether to use secure cookies (false for local development, true for production)
AUTH_COOKIE_SECURE=false

# Upload directory (optional, defaults to /app/uploads)
UPLOAD_DIR=/app/uploads

# Math detector device: cuda (GPU) or cpu
# GPU requires nvidia-docker and GPU support; leave empty to auto-detect
MATH_DETECTOR_DEVICE=cpu

# Math detector backend: onnx or torch
MATH_DETECTOR_BACKEND=onnx

# HuggingFace endpoint for model downloads
HF_ENDPOINT=https://huggingface.co
